{
  "expo": {
    "name": "POCO Naturals",
    "slug": "poco-naturals",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "poconaturals",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1E4D32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.poconaturals.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E4D32"
      },
      "package": "in.poconaturals.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
