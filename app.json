{
  "expo": {
    "name": "POCO Naturals",
    "slug": "poco-naturals",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "poconaturals",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFCFC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.poconaturals.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "in.poconaturals.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
